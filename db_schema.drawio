        <mxCell id="n185" value="&lt;b&gt;Indexes &amp; constraints&lt;/b&gt;&lt;br&gt;• &lt;b&gt;UNIQUE&lt;/b&gt; idx_job_info_company_ats_job (company_id, ats_job_id) — per-company dedup (V003)&lt;br&gt;• &lt;b&gt;INDEX&lt;/b&gt; idx_job_info_decision_created (user_decision, created_ts) — stale-job sweep (V014)&lt;br&gt;• V010 dropped the column-level UNIQUE on ats_job_id so two tenants can share a requisition id" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="426" height="118" as="geometry"/></mxCell>
        <mxCell id="n186" value="&lt;b&gt;Schema history&lt;/b&gt;&lt;br&gt;• V006 dropped job_info.description&lt;br&gt;• V012 re-added it as job_analysis.job_description — only for jobs past the score threshold" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1080" y="380" width="426" height="76" as="geometry"/></mxCell>
        <mxCell id="n187" value="&lt;b&gt;Standalone&lt;/b&gt; — no foreign keys.&lt;br&gt;Adaptive keyword scoring, keyed by the keyword text itself." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=#F5F5F5;strokeColor=#999999;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1080" y="716" width="426" height="48" as="geometry"/></mxCell>
        <mxCell id="n188" value="&lt;b&gt;Standalone&lt;/b&gt; — created by the migration runner (common/db/migrations.py), not by a V*.sql file." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=#F5F5F5;strokeColor=#999999;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1080" y="872" width="426" height="48" as="geometry"/></mxCell>
        <mxCell id="n189" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color='#B85450'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; primary key    &lt;font color='#6C8EBF'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; foreign key    &lt;font color='#82B366'&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; unique constraint&lt;br&gt;Connector lines attach to the exact join columns on both sides." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="426" height="76" as="geometry"/></mxCell>
