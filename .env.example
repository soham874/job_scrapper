MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=job_scrapper
# Pooled connections per process. 8 borg workers + API thread + advisory lock.
MYSQL_POOL_SIZE=10

# Telegram notifications (optional — leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public URL where the bot webhook is reachable (e.g. https://your-domain.com or ngrok URL)
TELEGRAM_WEBHOOK_URL=
# Shared secret Telegram echoes back on every webhook delivery, verified against
# the X-Telegram-Bot-Api-Secret-Token header. Leave empty and the webhook will
# accept any well-formed POST to a URL that has to be publicly reachable.
# 1-256 chars from A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=

# /test inserts a job row and messages the chat. Off by default so it is not
# left reachable on the public host.
ENABLE_TEST_ENDPOINT=false

# Optional shared secret for the read-only dashboard at /dashboard. Empty
# serves it to anyone who finds the URL; set it and the page needs ?t=<token>.
DASHBOARD_TOKEN=

# How far apart the borgs' scrape slots are spread. Each borg runs on its own
# slot inside this window instead of every borg waking at once. Capped at the
# cron interval (30 min).
BORG_STAGGER_WINDOW_SECONDS=1800

# Stale-job sweep. A job not applied to within SWEEP_AGE_HOURS is auto-rejected.
# Set the window to match how long your notifications survive in the chat.
SWEEP_AGE_HOURS=24
SWEEP_INTERVAL_SECONDS=21600

# Follow-up reminders. An application is nudged when its follow-up date arrives,
# or when its status has not moved for longer than common.applications allows.
REMINDER_INTERVAL_SECONDS=21600
REMINDER_RENOTIFY_HOURS=24
REMINDER_MAX_PER_RUN=10
